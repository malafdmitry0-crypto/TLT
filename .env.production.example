# =====================================================================
# ТЛТ / HeatCalc — production .env (для деплоя на VPS)
# =====================================================================
# Копировать в .env, заполнить КАЖДУЮ строку. Запуск:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Подробный playbook: docs/playbooks/deploy-reg-ru.md
# =====================================================================

# ────────── ОБЯЗАТЕЛЬНО ЗАПОЛНИТЬ ──────────

# Ваш домен (без http:// и без слэшей в конце)
SITE_DOMAIN=example.ru

# CORS — origin'ы, которым разрешено дёргать API.
# В простейшем случае — ваш SITE_DOMAIN с https://, через запятую можно
# добавить www-вариант или другие поддомены.
CORS_ORIGINS=https://example.ru,https://www.example.ru

# Сгенерировать ОБА пароля заранее, локально:
#   openssl rand -base64 48        # для SECRET_KEY
#   openssl rand -base64 24        # для POSTGRES_PASSWORD
SECRET_KEY=ЗАМЕНИТЬ_НА_ВЫХОД_OPENSSL_RAND_BASE64_48
POSTGRES_PASSWORD=ЗАМЕНИТЬ_НА_ВЫХОД_OPENSSL_RAND_BASE64_24

# Учётные данные первого администратора (создаётся при первом старте backend)
FIRST_ADMIN_EMAIL=admin@example.ru
FIRST_ADMIN_PASSWORD=ЗАМЕНИТЬ_НА_СЛОЖНЫЙ_ПАРОЛЬ_МИН_12_СИМВОЛОВ

# ────────── МОЖНО ОСТАВИТЬ ПО УМОЛЧАНИЮ ──────────

# PostgreSQL
POSTGRES_USER=heatcalc
POSTGRES_DB=heatcalc_db
POSTGRES_PORT=5432
# Planner/memory tuning. Поднимайте shared_buffers/effective_cache_size
# только если VPS/container реально имеет запас RAM.
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=8MB
POSTGRES_RANDOM_PAGE_COST=1.1
DATABASE_URL=postgresql+asyncpg://heatcalc:${POSTGRES_PASSWORD}@db:5432/heatcalc_db

# Тестовая БД — для dev/CI, в проде не нужна, но переменная читается
TEST_DATABASE_URL=postgresql+asyncpg://heatcalc:${POSTGRES_PASSWORD}@db:5432/heatcalc_test

# SQLAlchemy pools are per process. API and sequential worker have separate budgets.
API_DB_POOL_SIZE=5
API_DB_MAX_OVERFLOW=2
API_DB_POOL_TIMEOUT_SECONDS=10
WORKER_DB_POOL_SIZE=1
WORKER_DB_MAX_OVERFLOW=1
WORKER_DB_POOL_TIMEOUT_SECONDS=10

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend bundle строится с относительным /api/v1 (nginx внутри контейнера прокси)
VITE_API_BASE_URL=/api/v1

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Лимиты гостевых сессий (защита от ботов и DoS)
GUEST_MAX_SESSIONS_PER_IP=10
TRUSTED_PROXY_IPS=
GUEST_MAX_PROJECTS=1
GUEST_MAX_OBJECTS_PER_PROJECT=500
GUEST_SESSION_TTL_MINUTES=20
GUEST_CLEANUP_INTERVAL_MINUTES=10

# Distributed rate limiter / cache — Redis уже в стеке, оставляем включённым.
REDIS_URL=redis://redis:6379/0
WORKER_DEAD_LETTER_STREAM=heatcalc:tasks:cpu:dead
WORKER_MAX_ATTEMPTS=3

# Тег образов (если будете хранить версии — можно зафиксировать конкретный)
IMAGE_TAG=1.3.0-prod

# ⚠️ В проде НЕ создавать тестовые данные при старте
RUN_SEEDS=0
