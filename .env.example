# =====================================================================
# TLT / HeatCalc — пример переменных окружения
# =====================================================================
# Скопируйте файл в `.env` (без расширения .example) и при необходимости
# скорректируйте значения. Демо-сборка имеет отдельный `.env` в `demo/`.
# =====================================================================

# ---- PostgreSQL ----
POSTGRES_USER=heatcalc
POSTGRES_PASSWORD=heatcalc_pass
POSTGRES_DB=heatcalc_db
POSTGRES_PORT=5432
# Planner/memory tuning. Keep work_mem conservative: it is per sort/hash operation.
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=8MB
POSTGRES_RANDOM_PAGE_COST=1.1

# Main application DB
DATABASE_URL=postgresql+asyncpg://heatcalc:heatcalc_pass@db:5432/heatcalc_db
# Test DB (для pytest-integration; создаётся отдельно)
TEST_DATABASE_URL=postgresql+asyncpg://heatcalc:heatcalc_pass@db:5432/heatcalc_test

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
UVICORN_WORKERS=2
UVICORN_LIMIT_CONCURRENCY=100
UVICORN_BACKLOG=128
UVICORN_KEEPALIVE=5

# ---- Redis ----
# Redis хранит кэш/rate-limit и Redis Streams transport для worker'ов.
# volatile-lru вытесняет только TTL-ключи и не удаляет stream без TTL.
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=volatile-lru
WORKER_QUEUE_MAXLEN=10000
WORKER_PROGRESS_MIN_INTERVAL_MS=500
WORKER_PROGRESS_MIN_PERCENT_DELTA=1.0

# ---- Frontend ----
# Dev (docker-compose.yml + .dev.yml): публикуется nginx-проксируемый Vite dev на 3003.
# Prod (docker-compose.prod.yml): фронт перекрывает значение на 80. В demo — 8080.
FRONTEND_PORT=3003

# VITE_API_BASE_URL собирается на этапе build. Для dev — прямой адрес backend.
# Для prod — относительный путь `/api/v1` (nginx-прокси внутри frontend-контейнера).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---- CORS ----
# Comma-separated список origin'ов, которым разрешён доступ к API.
# Для prod: https://мойдомен.ru,https://www.мойдомен.ru
# Для dev можно не задавать — дефолты в config.py покрывают localhost.
# CORS_ORIGINS=

# ---- Production-only (не нужно в dev) ----
# SITE_DOMAIN — домен для Caddy (только при docker-compose.prod.yml).
# Полный prod-шаблон: см. .env.production.example + docs/playbooks/deploy-reg-ru.md
# SITE_DOMAIN=

# ---- JWT ----
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Первый администратор (создаётся при первом запуске backend) ----
FIRST_ADMIN_EMAIL=admin@heatcalc.io
FIRST_ADMIN_PASSWORD=admin

# ---- Лимиты пользовательских (гостевых) сессий ----
# Rate limit создания пользовательских сессий (sliding window, in-memory)
GUEST_SESSION_HOURLY_LIMIT=10
# У пользователя ровно один авто-проект (создаётся при POST /auth/guest)
GUEST_MAX_PROJECTS=1
# Максимум объектов на проект (в т.ч. для авторизованных)
GUEST_MAX_OBJECTS_PER_PROJECT=50
# TTL неактивной сессии в минутах; ушёл → через ≤ TTL + cleanup-interval всё чистится
GUEST_SESSION_TTL_MINUTES=20
# Периодичность фонового cleanup (минуты)
GUEST_CLEANUP_INTERVAL_MINUTES=10

# ---- Автосиды при старте (опционально) ----
# 1 — прогнать `python -m app.seeds` в entrypoint. Идемпотентно, безопасно.
# Для demo-сборки включено по умолчанию (см. `demo/.env.example`).
RUN_SEEDS=0
