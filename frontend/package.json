{
  "name": "heatcalc-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts,.tsx",
    "security:lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts,.tsx --quiet",
    "security:audit": "npm audit --audit-level=moderate",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run src/__tests__/unit",
    "test:wizard-isolation": "vitest run src/__tests__/unit/wizard/wizardIsolation.architecture.test.ts",
    "test:architecture": "vitest run src/__tests__/unit/architecture src/__tests__/unit/wizard/wizardIsolation.architecture.test.ts",
    "test:ui-kit": "vitest run src/__tests__/unit/components/UIKitLibrary.test.tsx src/__tests__/integration/pages/UIKitPage.test.tsx",
    "test:s0-gates": "vitest run src/__tests__/unit/architecture src/__tests__/unit/wizard/wizardIsolation.architecture.test.ts src/__tests__/unit/components/UIKitLibrary.test.tsx",
    "test:agent-gates": "npm run typecheck && npm run lint && npm run test:s0-gates",
    "test:integration": "vitest run src/__tests__/integration",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "perf:frontend": "node scripts/frontend-perf.mjs",
    "perf:heat-excel-virtual": "node scripts/heat-excel-virtual-perf.mjs",
    "verify:inline-form": "node scripts/verify-inline-form.mjs",
    "seed:guest:playwright": "node scripts/seed-guest-all-variants.mjs",
    "load:guest-query": "node scripts/load-guest-query.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.13.25",
    "@types/dompurify": "^3.0.5",
    "antd": "^5.21.0",
    "axios": "^1.15.2",
    "dompurify": "^3.4.0",
    "react": "^18.3.1",
    "react-aria-components": "^1.17.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "eslint-plugin-security": "^3.0.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "follow-redirects": "^1.16.0"
  }
}
