{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tlt.local/schemas/af11-browser-evidence-row.json",
  "title": "AF11 TLT browser evidence row",
  "description": "Machine-readable evidence row for AF11-BROWSER-CONTRACT-01. Example + schema; no state is claimed pass by this file alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "area",
    "state_id",
    "state_label",
    "required",
    "action_path",
    "url",
    "viewport",
    "viewport_profile",
    "screenshot",
    "geometry",
    "overflow",
    "console",
    "failed_network",
    "fixture_or_seed",
    "result",
    "blocker",
    "head",
    "captured_at_utc"
  ],
  "properties": {
    "area": {
      "type": "string",
      "enum": ["projects", "heat", "electrical", "specification", "reports"]
    },
    "state_id": {
      "type": "string",
      "pattern": "^(projects|heat|electrical|specification|reports)\\.[a-z0-9_]+$",
      "examples": ["heat.populated_normal", "projects.create_pending_modal"]
    },
    "state_label": {
      "type": "string",
      "minLength": 1
    },
    "required": {
      "type": "boolean",
      "const": true
    },
    "action_path": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Visible user actions that reached the settled state."
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "viewport_profile": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "kontur-desktop",
        "kontur-mobile",
        "tlt-shell-1000",
        "tlt-primary-qa",
        "tlt-dense-1280",
        "tlt-wide"
      ]
    },
    "screenshot": {
      "type": "string",
      "description": "Repo-relative path to same-HEAD PNG.",
      "minLength": 1
    },
    "geometry": {
      "description": "Path to geometry JSON or inline metrics object.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "properties": {
            "page": { "type": "object" },
            "regions": { "type": "object" }
          },
          "additionalProperties": true
        }
      ]
    },
    "overflow": {
      "type": "object",
      "required": ["page_overflow_x", "page_overflow_y"],
      "properties": {
        "page_overflow_x": { "type": "boolean" },
        "page_overflow_y": { "type": "boolean" },
        "scroll_width": { "type": "number" },
        "client_width": { "type": "number" },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "overflow_x": { "type": "boolean" },
              "allowed": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "console": {
      "type": "object",
      "required": ["pageerrors", "errors", "warnings"],
      "properties": {
        "pageerrors": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "excerpts": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "failed_network": {
      "type": "object",
      "required": ["unexpected_count"],
      "properties": {
        "unexpected_count": { "type": "integer", "minimum": 0 },
        "expected": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url_pattern": { "type": "string" },
              "reason": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "unexpected": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "status": { "type": ["integer", "null"] },
              "error": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "fixture_or_seed": {
      "type": ["string", "null"],
      "description": "Documented seed/fixture and the user behavior it represents."
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail", "blocked", "not_run"]
    },
    "blocker": {
      "type": ["string", "null"]
    },
    "head": {
      "type": "string",
      "minLength": 7,
      "description": "git rev-parse HEAD of the tree under test"
    },
    "captured_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "area": "projects",
      "state_id": "projects.populated",
      "state_label": "populated",
      "required": true,
      "action_path": [
        "open /login",
        "sign in as employee",
        "navigate to Projects",
        "wait until project table settles with >=1 row"
      ],
      "url": "http://127.0.0.1:3003/projects",
      "viewport": { "width": 1440, "height": 1000 },
      "viewport_profile": "kontur-desktop",
      "screenshot": "docs/audit/2026-07-25-af11-browser-projects/browser/projects.populated-1440x1000.png",
      "geometry": "docs/audit/2026-07-25-af11-browser-projects/browser/projects.populated-1440x1000-geometry.json",
      "overflow": {
        "page_overflow_x": false,
        "page_overflow_y": false,
        "scroll_width": 1440,
        "client_width": 1440,
        "regions": []
      },
      "console": {
        "pageerrors": 0,
        "errors": 0,
        "warnings": 0,
        "excerpts": []
      },
      "failed_network": {
        "unexpected_count": 0,
        "expected": [],
        "unexpected": []
      },
      "fixture_or_seed": "employee login petrov@heatcalc.io — represents employee projects list with existing projects",
      "result": "not_run",
      "blocker": null,
      "head": "faa6aabccc8988151cd112b9ebf66ccd83345bf0",
      "captured_at_utc": "2026-07-25T02:17:03Z"
    }
  ]
}
